# JACC Production Environment Configuration
# Copy these to your Replit deployment environment variables

# =================================
# DATABASE CONFIGURATION
# =================================

# Option 1: Use existing database (Quick deployment)
DATABASE_URL=postgresql://neondb_owner:npg_YDFJ7ytUa6in@ep-fancy-sunset-adfdorp5.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require

# Option 2: New production database (Replace with your values)
# DATABASE_URL=postgresql://prod_user:prod_password@prod_host:5432/prod_database?sslmode=require

# =================================
# SECURITY CONFIGURATION
# =================================

# Generate new session secret for production security
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SESSION_SECRET=GENERATE_NEW_SECRET_FOR_PRODUCTION_64_CHARACTERS_LONG

# =================================
# AI SERVICE CONFIGURATION
# =================================

# Anthropic Claude API (Primary AI service)
ANTHROPIC_API_KEY=your_production_anthropic_api_key

# OpenAI API (Secondary AI service)
OPENAI_API_KEY=your_production_openai_api_key

# Pinecone Vector Database (Document search)
PINECONE_API_KEY=your_production_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=merchant-docs-v3

# =================================
# APPLICATION CONFIGURATION
# =================================

# Environment
NODE_ENV=production

# Application URL
PRODUCTION_DOMAIN=https://your-app-name.replit.app

# Port (Replit will override this)
PORT=3000

# =================================
# OPTIONAL INTEGRATIONS
# =================================

# Email service (if using SendGrid)
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging level
LOG_LEVEL=info

# =================================
# DEPLOYMENT CHECKLIST
# =================================

# ✅ 1. Set DATABASE_URL (use Option 1 for quick deployment)
# ✅ 2. Generate new SESSION_SECRET
# ✅ 3. Add your AI service API keys
# ✅ 4. Update PRODUCTION_DOMAIN to your app URL
# ✅ 5. Deploy your application
# ✅ 6. Test login and data access